;NE2000 Ethernet driver install script
;Grzegorz "Krashan" Kraszewski
;$VER: Ne2000 install 0.21 (9.9.2001)
;Modified 2024-2026 by Steen Lund for openpci-rtl8029.device: new file names, card
;check with lspci from the openpci package, Polish strings removed
;SPDX-License-Identifier: GPL-2.0-or-later

(complete 0)

;language strings
(set #msg_welcome "Welcome in RTL8029 Ethernet board driver installer.")
(set #msg_nocard "Sorry, the installer did not find any RTL8029 based Ethernet card in your system. Make sure it is inserted and working and run the installer again.")
(set #msg_noopenpci "openpci.library was not found in LIBS:. The driver needs it: install the openpci package (Aminet driver/other/openpci68k.lha) first.")
(set #msg_nolspci "The lspci command of the openpci package could not be run, so the installer cannot check for an RTL8029 card. The driver will be installed anyway.")
(set #msg_destdir "Select the directory where the driver file will be copied to.")
(set #msg_desthelp "There is really no reason why you may want to change the default 'DEVS:Networks/' location. But you are an expert, aren't you? So do what you want, but have been warned.")
(set #msg_copydrv "Copying driver file.")
(set #msg_choice "Select operation.")
(set #msg_choice0 "[2pInstall/Update")
(set #msg_choice1 "Remove")
(set #msg_chelp "You can install the driver (or update if you have an older version installed already), or remove it from the system.")
(set #msg_deldir "Select the directory where you have installed the driver.")
(set #msg_delhelp "Well you are naming yourself an expert, so you are supposed to know where the driver is...")
(set #msg_sure "Are you sure you want to remove RTL8029 Ethernet card driver from the system?")
(set #msg_hsure "If you answer 'Yes' the driver will be deleted.")
(set #msg_removed " has been removed from '")
(set #msg_removed1 "' directory.")

(set #destpath "DEVS:Networks")
(welcome #msg_welcome)

;Look for the card in the device list of lspci. With NUMERIC it prints the vendor and
;device IDs as "10ec:8029". Search returns 0 when it finds the text. If lspci printed no
;device at all, it is missing or failed, and the card cannot be checked.
(set #lspci "T:openpci-rtl8029.lspci")
(run (cat "lspci NUMERIC >" #lspci) (safe))
(set #card (= 0 (run (cat "Search >NIL: " #lspci " 10ec:8029 QUIET") (safe))))
(set #listed (= 0 (run (cat "Search >NIL: " #lspci " \"(rev \" QUIET") (safe))))
(delete #lspci (safe))
(set #operation
	(askchoice
   	(prompt #msg_choice)
      (help #msg_chelp)
      (choices #msg_choice0 #msg_choice1)
   )
)

(debug #operation)

(if (= #operation 0)
	(
      (if (not (exists "LIBS:openpci.library"))
         (abort #msg_noopenpci)
      )
      (if (not #listed)
         (message #msg_nolspci)
      )
      (if (or #card (not #listed))
      	(
         	(if (= @user-level 2)
            	(set #destpath
            		(askdir
                  	(prompt #msg_destdir)
                     (help #msg_desthelp)
                     (default #destpath)
                     (newpath)
                  )
            	)
            )

            (copylib
            	(prompt #msg_copydrv)
               (help #msg_copydrv)
               (confirm)
               (source "openpci-rtl8029.device")
               (dest #destpath)
               (infos)
            )
       	)
         (
         	(abort #msg_nocard)
         )
      )
   )

   (
   	(if (= @user-level 2)
      	(set #destpath
      		(askdir
            	(prompt #msg_deldir)
               (help #msg_delhelp)
               (default #destpath)
            )
      	)
      )

      (if (= 1 (askbool (prompt #msg_sure) (help #msg_hsure) (default 0))
      	(delete (tackon #destpath "openpci-rtl8029.device") (prompt "") (help "") (infos))
         (set #msg_exit (cat @app-name #msg_removed #destpath #msg_removed1))
         (exit #msg_exit (quiet))
         )
      )
   )
)

(set @default-dest #destpath)
(exit)
